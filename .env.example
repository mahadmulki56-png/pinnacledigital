# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PIN_HASH: Bcrypt hash of the 4-digit administrator PIN (default PIN is 1296).
# AI Studio injects this from the Secrets panel. If omitted, the server uses a built-in bcrypt hash for '1296'.
ADMIN_PIN_HASH=""

# INQUIRY_ENCRYPTION_KEY: 32-byte secret key (64 hex characters or 32-char passphrase) used to encrypt sensitive inquiry data at rest using AES-256-GCM.
# AI Studio injects this from the Secrets panel. If omitted, the server falls back to a deterministic machine key.
INQUIRY_ENCRYPTION_KEY=""

